/-!
# Actual regional symmetry and boundary-state laws

Configurations are the actual finite iid configurations. The symmetry group
is generated by the verified common automorphisms selected by `regionalPerms`.
Actions use inverse pullback, consistently on vertices and boundary states.
-/

open MeasureTheory ProbabilityTheory
open scoped BigOperators ENNReal

namespace SitePerc.Checker

/-- Vertex and boundary permutations, with the same composition convention. -/
abbrev RegionalPermutationPair (m : Nat) :=
  Equiv.Perm (Fin (m*m)) × Equiv.Perm (Fin (squareBoundary m).size)

/-- The actual selected paired permutations; there is no abstract D4 assumption. -/
def regionalActionGenerators (m : Nat) (hm : RegionalSize m) :
    Set (RegionalPermutationPair m) :=
  Set.range (fun t : Fin (regionalVertexPerms m).size =>
    (regionalVertexEquiv m hm t, regionalBoundaryIndexEquiv m hm t))

/-- The genuine finite group generated by the checker's selected symmetries. -/
def regionalActionGroup (m : Nat) (hm : RegionalSize m) :
    Subgroup (RegionalPermutationPair m) := Subgroup.closure (regionalActionGenerators m hm)

/-- Direct extraction from a finite configuration at the actual ordered boundary. -/
noncomputable def regionalState (m : Nat) (hm : RegionalSize m) (mode : Fin 3)
    (ω : Configuration (Fin (m*m))) : BoundaryState (Fin (squareBoundary m).size) := by
  classical
  exact { opened := fun i => ω (regionalBoundaryVertex m hm i)
          connected := fun i j => decide ((siteGraph
            (edgeGraph (m*m) (gridEdges m mode.val)) ω).Reachable
              (regionalBoundaryVertex m hm i) (regionalBoundaryVertex m hm j)) }

/-- Extend a genuinely finite configuration only to use the native Nat-indexed API. -/
def regionalNatConfig {n : Nat} (ω : Configuration (Fin n)) (i : Nat) : Bool :=
  if hi : i < n then ω ⟨i, hi⟩ else false

/-- Inverse pullback is a left action, unlike uninverted precomposition. -/
def regionalConfigMove {m : Nat} (g : RegionalPermutationPair m)
    (ω : Configuration (Fin (m*m))) : Configuration (Fin (m*m)) :=
  fun v => ω (g.1.symm v)

/-- Both fields of the augmented boundary state move together. -/
def regionalStateMove {m : Nat} (g : RegionalPermutationPair m)
    (s : BoundaryState (Fin (squareBoundary m).size)) :
    BoundaryState (Fin (squareBoundary m).size) := reindexState g.2.symm s

end SitePerc.Checker

namespace SitePerc.Checker

/-- The selected common automorphisms and their boundary actions form this subgroup. -/
def regionalCommonGroup (m : Nat) (hm : RegionalSize m) : Subgroup (RegionalPermutationPair m) where
  carrier g :=
    (∀ mode : Fin 3, ∀ x y, (edgeGraph (m*m) (gridEdges m mode.val)).Adj (g.1 x) (g.1 y) ↔
      (edgeGraph (m*m) (gridEdges m mode.val)).Adj x y) ∧
    (∀ i, g.1 (regionalBoundaryVertex m hm i) = regionalBoundaryVertex m hm (g.2 i))
  one_mem' := by constructor <;> simp
  mul_mem' := by
    intro a b ha hb
    constructor
    · intro mode x y
      exact (ha.1 mode (b.1 x) (b.1 y)).trans (hb.1 mode x y)
    · intro i
      change a.1 (b.1 (regionalBoundaryVertex m hm i)) =
        regionalBoundaryVertex m hm (a.2 (b.2 i))
      rw [hb.2, ha.2]
  inv_mem' := by
    intro a ha
    constructor
    · intro mode x y
      simpa using (ha.1 mode (a.1.symm x) (a.1.symm y)).symm
    · intro i
      have h := congrArg a.1.symm (ha.2 (a.2.symm i))
      simpa using h.symm

/-- Every generated symmetry is a genuine common graph/boundary automorphism. -/
theorem regionalActionGroup_common (m : Nat) (hm : RegionalSize m)
    (g : regionalActionGroup m hm) : g.val ∈ regionalCommonGroup m hm := by
  apply (Subgroup.closure_le (regionalCommonGroup m hm)).mpr ?_ g.property
  rintro _ ⟨t, rfl⟩
  exact ⟨regionalVertexEquiv_adj m hm t, regional_boundary_commutes m hm t⟩

noncomputable instance regionalActionGroup_fintype (m : Nat) (hm : RegionalSize m) :
    Fintype (regionalActionGroup m hm) := Fintype.ofFinite _

instance regionalConfigAction (m : Nat) (hm : RegionalSize m) :
    MulAction (regionalActionGroup m hm) (Configuration (Fin (m*m))) where
  smul g ω := regionalConfigMove g.val ω
  one_smul ω := by funext i; rfl
  mul_smul a b ω := by
    funext i
    rfl

instance regionalBoundaryAction (m : Nat) (hm : RegionalSize m) :
    MulAction (regionalActionGroup m hm) (BoundaryState (Fin (squareBoundary m).size)) where
  smul g s := regionalStateMove g.val s
  one_smul s := by cases s; rfl
  mul_smul a b s := by cases s; rfl

/-- Pointwise site weights do not depend on the names of finite coordinates. -/
theorem regional_configWeight_permutation {A : Type} [Fintype A]
    (p : Parameter) (e : Equiv.Perm A) (ω : Configuration A) :
    configWeight p (fun i => ω (e i)) = configWeight p ω := by
  classical
  have hopen : SitePerc.openCount (fun i => ω (e i)) = SitePerc.openCount ω := by
    rw [SitePerc.openCount, SitePerc.openCount, ← Fintype.card_subtype,
      ← Fintype.card_subtype]
    exact Fintype.card_congr (e.subtypeEquiv (by intro i; rfl))
  have hclosed : closedCount (fun i => ω (e i)) = closedCount ω := by
    rw [closedCount, closedCount, ← Fintype.card_subtype, ← Fintype.card_subtype]
    exact Fintype.card_congr (e.subtypeEquiv (by intro i; rfl))
  simp only [configWeight, hopen, hclosed]

/-- An actual finite iid law is invariant under every finite-coordinate permutation. -/
theorem regional_finite_iid_invariant {A : Type} [Fintype A] [DecidableEq A]
    (p : Parameter) (e : Equiv.Perm A) (ω : Configuration A) :
    (finiteStateLaw p (id : Configuration A → Configuration A)).mass (fun i => ω (e i)) =
      (finiteStateLaw p (id : Configuration A → Configuration A)).mass ω := by
  rw [finiteStateLaw_mass, finiteStateLaw_mass]
  simp only [id_eq, Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
  exact regional_configWeight_permutation p e ω

/-- The actual generated group preserves every iid configuration mass. -/
theorem regional_configLaw_invariant (m : Nat) (hm : RegionalSize m) (p : Parameter)
    (g : regionalActionGroup m hm) (ω : Configuration (Fin (m*m))) :
    (finiteStateLaw p (id : Configuration (Fin (m*m)) → _)).mass (g • ω) =
      (finiteStateLaw p (id : Configuration (Fin (m*m)) → _)).mass ω :=
  regional_finite_iid_invariant p g.val.1.symm ω

end SitePerc.Checker

namespace SitePerc.Checker

/-- The raw augmented state is finite, without quotienting away closed bits. -/
noncomputable instance regionalBoundaryState_fintype (b : Nat) :
    Fintype (BoundaryState (Fin b)) :=
  Fintype.ofEquiv ((Fin b → Bool) × (Fin b → Fin b → Bool))
    { toFun := fun z => ⟨z.1, z.2⟩
      invFun := fun s => (s.opened, s.connected)
      left_inv := by intro z; rfl
      right_inv := by intro s; cases s; rfl }

noncomputable instance regionalBoundaryState_decidableEq (b : Nat) :
    DecidableEq (BoundaryState (Fin b)) := Classical.decEq _

/-- The order ignores irrelevant closed connection bits, so only a preorder is used. -/
def regionalBoundaryPreorder (b : Nat) : Preorder (BoundaryState (Fin b)) where
  le := stateLE
  le_refl _ := ⟨fun _ h => h, fun _ _ _ _ h => h⟩
  le_trans _ _ _ h k := ⟨fun i hi => k.1 i (h.1 i hi),
    fun i j hi hj hij => k.2 i j (h.1 i hi) (h.1 j hj) (h.2 i j hi hj hij)⟩

/-- Opening a graph commutes with a genuine graph automorphism. -/
def regionalOpenGraphIso {A : Type} (G : SimpleGraph A) (e : Equiv.Perm A)
    (he : ∀ x y, G.Adj (e x) (e y) ↔ G.Adj x y) (ω : Configuration A) :
    siteGraph G (fun x => ω (e x)) ≃g siteGraph G ω where
  toEquiv := e
  map_rel_iff' := by
    intro x y
    simp only [siteGraph, SimpleGraph.fromRel_adj, e.injective.ne_iff, he]

/-- Direct boundary extraction is equivariant under every generated symmetry. -/
theorem regionalState_equivariant (m : Nat) (hm : RegionalSize m) (mode : Fin 3)
    (g : regionalActionGroup m hm) (ω : Configuration (Fin (m*m))) :
    regionalState m hm mode (g • ω) = g • regionalState m hm mode ω := by
  classical
  have hg := regionalActionGroup_common m hm g⁻¹
  have hcomm (i : Fin (squareBoundary m).size) :
      g.val.1.symm (regionalBoundaryVertex m hm i) =
        regionalBoundaryVertex m hm (g.val.2.symm i) := hg.2 i
  let φ := regionalOpenGraphIso (edgeGraph (m*m) (gridEdges m mode.val))
    g.val.1.symm (hg.1 mode) ω
  change BoundaryState.mk _ _ = BoundaryState.mk _ _
  congr 1
  · funext i
    change ω (g.val.1.symm (regionalBoundaryVertex m hm i)) =
      ω (regionalBoundaryVertex m hm (g.val.2.symm i))
    rw [hcomm]
  · funext i j
    change decide ((siteGraph (edgeGraph (m*m) (gridEdges m mode.val))
        (fun x => ω (g.val.1.symm x))).Reachable
          (regionalBoundaryVertex m hm i) (regionalBoundaryVertex m hm j)) =
      decide ((siteGraph (edgeGraph (m*m) (gridEdges m mode.val)) ω).Reachable
        (regionalBoundaryVertex m hm (g.val.2.symm i))
        (regionalBoundaryVertex m hm (g.val.2.symm j)))
    simp only [decide_eq_decide]
    have h := (SimpleGraph.Iso.reachable_iff (φ := φ)
      (u := regionalBoundaryVertex m hm i) (v := regionalBoundaryVertex m hm j)).symm
    change ((siteGraph (edgeGraph (m*m) (gridEdges m mode.val))
      (fun x => ω (g.val.1.symm x))).Reachable
        (regionalBoundaryVertex m hm i) (regionalBoundaryVertex m hm j) ↔
      (siteGraph (edgeGraph (m*m) (gridEdges m mode.val)) ω).Reachable
        (g.val.1.symm (regionalBoundaryVertex m hm i))
        (g.val.1.symm (regionalBoundaryVertex m hm j))) at h
    rw [hcomm, hcomm] at h
    exact h

/-- Every generated boundary action preserves and reflects the actual state order. -/
theorem regionalState_orderAction (m : Nat) (hm : RegionalSize m)
    (g : regionalActionGroup m hm) (s t : BoundaryState (Fin (squareBoundary m).size)) :
    stateLE s t ↔ stateLE (g • s) (g • t) := by
  change stateLE s t ↔ stateLE (reindexState g.val.2.symm s)
    (reindexState g.val.2.symm t)
  constructor
  · intro h
    exact ⟨fun i hi => h.1 _ hi, fun i j hi hj hc => h.2 _ _ hi hj hc⟩
  · intro h
    constructor
    · intro i hi
      simpa [reindexState] using h.1 (g.val.2 i) (by simpa [reindexState] using hi)
    · intro i j hi hj hc
      simpa [regionalStateMove, reindexState] using h.2 (g.val.2 i) (g.val.2 j)
        (by simpa [regionalStateMove, reindexState] using hi)
        (by simpa [regionalStateMove, reindexState] using hj)
        (by simpa [regionalStateMove, reindexState] using hc)

/-- Actual finite iid weights push forward to the actual observed state law. -/
theorem regionalStateLaw_mass (m : Nat) (hm : RegionalSize m) (mode : Fin 3) (p : Parameter)
    (s : BoundaryState (Fin (squareBoundary m).size)) :
    (finiteStateLaw p (regionalState m hm mode)).mass s =
      (finiteLawMap (finiteStateLaw p (id : Configuration (Fin (m*m)) → _))
        (regionalState m hm mode)).mass s := by
  classical
  rw [finiteStateLaw_mass]
  change _ = ∑ ω, if regionalState m hm mode ω = s then
    (finiteStateLaw p (id : Configuration (Fin (m*m)) → _)).mass ω else 0
  congr 1
  funext ω
  rw [finiteStateLaw_mass]
  simp

/-- Exact invariance of the real finite iid boundary-state law, not an input table. -/
theorem regionalStateLaw_invariant (m : Nat) (hm : RegionalSize m) (mode : Fin 3) (p : Parameter)
    (g : regionalActionGroup m hm) (s : BoundaryState (Fin (squareBoundary m).size)) :
    (finiteStateLaw p (regionalState m hm mode)).mass (g • s) =
      (finiteStateLaw p (regionalState m hm mode)).mass s := by
  rw [regionalStateLaw_mass, regionalStateLaw_mass]
  exact finiteLawMap_invariant
    (finiteStateLaw p (id : Configuration (Fin (m*m)) → _))
    (regionalState m hm mode) (regional_configLaw_invariant m hm p)
    (regionalState_equivariant m hm mode) g s

end SitePerc.Checker

namespace SitePerc.Checker

/-- The finite site graph is literally the native openGraph, not an extraction premise. -/
theorem regional_siteGraph_eq_native (n : Nat) (es : List Edge)
    (ω : Configuration (Fin n)) :
    siteGraph (edgeGraph n es) ω = openGraph n es (regionalNatConfig ω) := by
  ext a b
  simp only [siteGraph, edgeGraph, openGraph, SimpleGraph.fromRel_adj,
    regionalNatConfig, dif_pos a.isLt, dif_pos b.isLt]
  tauto

/-- The direct extraction equals the codec's actual native boundary observation. -/
theorem regionalState_eq_observed (m : Nat) (hm : RegionalSize m) (mode : Fin 3)
    (ω : Configuration (Fin (m*m))) :
    regionalState m hm mode ω = observedBoundaryState (gridEdges m mode.val)
      (regionalNatConfig ω) (regionalBoundaryVertex m hm) := by
  classical
  change BoundaryState.mk _ _ = BoundaryState.mk _ _
  congr 1
  · funext i
    simp [regionalNatConfig]
  · funext i j
    simp only [regional_siteGraph_eq_native]

/-- No two stored boundary positions name the same vertex. -/
theorem regionalBoundaryVertex_injective (m : Nat) (hm : RegionalSize m) :
    Function.Injective (regionalBoundaryVertex m hm) := by
  intro i j hij
  apply Fin.ext
  have hi : i.val < (squareBoundary m).toList.length := by simpa using i.isLt
  have hj : j.val < (squareBoundary m).toList.length := by simpa using j.isLt
  apply ((regionalBoundaryData m hm).2.1.getElem_inj_iff (hi := hi) (hj := hj)).mp
  have h := congrArg Fin.val hij
  simpa only [regionalBoundaryVertex, getElem!_pos (squareBoundary m) i.val i.isLt,
    getElem!_pos (squareBoundary m) j.val j.isLt, Array.getElem_toList] using h

/-- Every actual regional edge endpoint is in the finite board. -/
theorem regional_edges_bounded (m : Nat) (hm : RegionalSize m) (mode : Fin 3) :
    BoundedEdges (m*m) (gridEdges m mode.val) := by
  have h : (gridEdges m mode.val).all (fun e => decide (e.1 < m*m ∧ e.2 < m*m)) = true := by
    rcases hm with rfl | rfl | rfl <;> fin_cases mode <;> decide +kernel
  intro e he
  exact of_decide_eq_true (List.all_eq_true.mp h e he)

/-- Native mask observation has exactly the direct finite-configuration meaning. -/
theorem regionalState_mask_eq_observed (m : Nat) (hm : RegionalSize m) (mode : Fin 3)
    (mask : Nat) :
    regionalState m hm mode (fun v => mask.testBit v.val) =
      observedBoundaryState (gridEdges m mode.val) mask.testBit (regionalBoundaryVertex m hm) := by
  classical
  have hG : siteGraph (edgeGraph (m*m) (gridEdges m mode.val))
      (fun v => mask.testBit v.val) = openGraph (m*m) (gridEdges m mode.val) mask.testBit := by
    ext a b
    simp only [siteGraph, edgeGraph, openGraph, SimpleGraph.fromRel_adj]
    tauto
  change BoundaryState.mk _ _ = BoundaryState.mk _ _
  congr 1
  funext i j
  rw [hG]

/-- Actual UF/rootLabels extraction equals the direct iid boundary extraction. -/
theorem regional_rootLabels_extraction (m : Nat) (hm : RegionalSize m) (mode : Fin 3)
    (mask : Nat) :
    stateOfLabels (squareBoundary m).size
      (rootLabels (m*m) (gridEdges m mode.val) (squareBoundary m) mask) =
      regionalState m hm mode (fun v => mask.testBit v.val) := by
  have hb : ∀ x ∈ (squareBoundary m).toList, x < m*m := by
    intro x hx
    obtain ⟨i, hi, rfl⟩ := List.mem_iff_getElem.mp hx
    have hi' : i < (squareBoundary m).size := by simpa using hi
    simpa only [getElem!_pos (squareBoundary m) i hi', Array.getElem_toList] using
      (regionalBoundaryData m hm).2.2.1 ⟨i, hi'⟩
  have hbe : boundaryEmbedding (m*m) (squareBoundary m) hb = regionalBoundaryVertex m hm := by
    funext i
    apply Fin.ext
    simp [boundaryEmbedding, regionalBoundaryVertex]
  rw [rootLabels_state_eq_observed (m*m) (gridEdges m mode.val) (squareBoundary m)
    mask (regional_edges_bounded m hm mode) hb
    (by simpa only [hbe] using regionalBoundaryVertex_injective m hm), hbe]
  exact (regionalState_mask_eq_observed m hm mode mask).symm

end SitePerc.Checker

namespace SitePerc.Checker

/-- A fold of minimum chooses one of the actually inspected candidates. -/
theorem regional_min_fold_witness (f : Array Nat → Nat) (ps : List (Array Nat)) (init : Nat) :
    ps.foldl (fun z p => min z (f p)) init = init ∨
      ∃ p ∈ ps, ps.foldl (fun z p => min z (f p)) init = f p := by
  induction ps generalizing init with
  | nil => exact Or.inl rfl
  | cons p ps ih =>
    simp only [List.foldl_cons]
    rcases ih (min init (f p)) with h | ⟨q, hq, h⟩
    · by_cases hp : init ≤ f p
      · exact Or.inl (h.trans (min_eq_left hp))
      · exact Or.inr ⟨p, by simp, h.trans (min_eq_right (le_of_not_ge hp))⟩
    · exact Or.inr ⟨q, by simp [hq], h⟩

/-- The actual canonical min is at most every selected permutation's code. -/
theorem regional_canonicalKey_le (xs : List Nat) (ps : Array (Array Nat)) :
    canonicalKey xs ps ≤ packR10 (normalize xs) ∧
      ∀ p ∈ ps.toList, canonicalKey xs ps ≤ packR10 (normalize (permute xs p)) := by
  have hf (ls : List (Array Nat)) (init : Nat) :
      ls.foldl (fun z p => min z (packR10 (normalize (permute xs p)))) init ≤ init ∧
        ∀ p ∈ ls, ls.foldl (fun z p => min z (packR10 (normalize (permute xs p)))) init ≤
          packR10 (normalize (permute xs p)) := by
    induction ls generalizing init with
    | nil => simp
    | cons p ls ih =>
      have hh := ih (min init (packR10 (normalize (permute xs p))))
      constructor
      · exact hh.1.trans (min_le_left _ _)
      · intro q hq
        rcases List.mem_cons.mp hq with rfl | hq
        · exact hh.1.trans (min_le_right _ _)
        · exact hh.2 q hq
  simpa only [canonicalKey, ← Array.foldl_toList] using hf ps.toList (packR10 (normalize xs))

/-- Canonicalization selects a representative in the actual generated state orbit. -/
theorem regional_canonical_witness (m : Nat) (hm : RegionalSize m) (xs : List Nat)
    (hlen : xs.length = (squareBoundary m).size) :
    ∃ ys : List Nat, ys.length = (squareBoundary m).size ∧
      canonicalKey xs (regionalPerms m) = packR10 (normalize ys) ∧
      ∃ g : regionalActionGroup m hm,
        stateOfLabels (squareBoundary m).size ys = g • stateOfLabels (squareBoundary m).size xs := by
  have hfold := regional_min_fold_witness
    (fun p => packR10 (normalize (permute xs p))) (regionalPerms m).toList
    (packR10 (normalize xs))
  have hfold' : canonicalKey xs (regionalPerms m) = packR10 (normalize xs) ∨
      ∃ p ∈ (regionalPerms m).toList,
        canonicalKey xs (regionalPerms m) = packR10 (normalize (permute xs p)) := by
    simpa only [canonicalKey, ← Array.foldl_toList] using hfold
  rcases hfold' with h | ⟨p, hp, h⟩
  · exact ⟨xs, hlen, h, 1, by simp⟩
  · obtain ⟨i, hi, heq⟩ := List.mem_iff_getElem.mp hp
    have hi' : i < (regionalPerms m).size := by simpa using hi
    let t : Fin (regionalVertexPerms m).size :=
      ⟨i, by rw [← (regionalPermutationData m hm).1]; exact hi'⟩
    have hp' : p = (regionalPerms m)[t.val]! := by
      rw [getElem!_pos (regionalPerms m) t.val hi']
      exact heq.symm
    let g : regionalActionGroup m hm :=
      ⟨(regionalVertexEquiv m hm t, regionalBoundaryIndexEquiv m hm t),
        Subgroup.subset_closure ⟨t, rfl⟩⟩
    have hr : RepresentsPermutation (squareBoundary m).size p (regionalBoundaryIndexEquiv m hm t) := by
      rw [hp']
      exact regionalBoundaryIndexEquiv_represents m hm t
    refine ⟨permute xs p, by simp [permute, hr.1], h, g⁻¹, ?_⟩
    exact stateOfLabels_permute _ xs p _ hr

/-- Decoding the actual canonical key returns a representative of the actual orbit. -/
theorem regional_canonical_decode_orbit (m : Nat) (hm : RegionalSize m) (xs : List Nat)
    (hlen : xs.length = (squareBoundary m).size) :
    ∃ g : regionalActionGroup m hm,
      decodeState (squareBoundary m).size (canonicalKey xs (regionalPerms m)) =
        g • stateOfLabels (squareBoundary m).size xs := by
  obtain ⟨ys, hys, hkey, g, hg⟩ := regional_canonical_witness m hm xs hlen
  refine ⟨g, ?_⟩
  rw [hkey, normalizedPackedKey_decode _ ys hys]
  · exact hg
  · have hb := (regionalBoundaryData m hm).1
    rcases hm with rfl | rfl | rfl <;> omega

end SitePerc.Checker

namespace SitePerc.Checker

/-- The actual orbit quotient of raw augmented boundary states. -/
abbrev RegionalOrbit (m : Nat) (hm : RegionalSize m) :=
  MulAction.orbitRel.Quotient (regionalActionGroup m hm)
    (BoundaryState (Fin (squareBoundary m).size))

/-- Literal quotient projection; no purported canonical-fiber fact is built in. -/
def regionalOrbitProjection (m : Nat) (hm : RegionalSize m)
    (s : BoundaryState (Fin (squareBoundary m).size)) : RegionalOrbit m hm :=
  Quotient.mk _ s

noncomputable instance regionalOrbit_fintype (m : Nat) (hm : RegionalSize m) :
    Fintype (RegionalOrbit m hm) := Fintype.ofFinite _

noncomputable instance regionalOrbit_decidableEq (m : Nat) (hm : RegionalSize m) :
    DecidableEq (RegionalOrbit m hm) := Classical.decEq _

/-- Surjectivity is discharged by the actual quotient definition. -/
theorem regionalOrbitProjection_surjective (m : Nat) (hm : RegionalSize m) :
    Function.Surjective (regionalOrbitProjection m hm) := by
  intro q
  exact Quotient.inductionOn q (fun s => ⟨s, rfl⟩)

/-- Fibers are actual group orbits, by quotient semantics rather than an input. -/
theorem regionalOrbitProjection_fibers (m : Nat) (hm : RegionalSize m)
    (s t : BoundaryState (Fin (squareBoundary m).size)) :
    regionalOrbitProjection m hm s = regionalOrbitProjection m hm t ↔
      ∃ g : regionalActionGroup m hm, g • s = t := by
  rw [regionalOrbitProjection, regionalOrbitProjection, eq_comm, Quotient.eq]
  exact MulAction.mem_orbit_iff

/-- C's proved construction gives the orbit preorder for the actual stateLE. -/
noncomputable instance regionalOrbit_preorder (m : Nat) (hm : RegionalSize m) :
    Preorder (RegionalOrbit m hm) := by
  letI := regionalBoundaryPreorder (squareBoundary m).size
  exact orbitPreorder (regionalOrbitProjection m hm) (regionalOrbitProjection_surjective m hm)
    (regionalOrbitProjection_fibers m hm) (regionalState_orderAction m hm)

/-- Actual orbit comparison is exactly an order comparison after moving the target. -/
theorem regionalOrbit_le_iff (m : Nat) (hm : RegionalSize m)
    (s t : BoundaryState (Fin (squareBoundary m).size)) :
    regionalOrbitProjection m hm s ≤ regionalOrbitProjection m hm t ↔
      ∃ g : regionalActionGroup m hm, stateLE s (g • t) := by
  letI := regionalBoundaryPreorder (squareBoundary m).size
  exact orbitPreorder_le_iff (regionalOrbitProjection m hm)
    (regionalOrbitProjection_surjective m hm) (regionalOrbitProjection_fibers m hm)
    (regionalState_orderAction m hm) s t

/-- Direct C adapter on actual finite iid laws and actual BoundaryState/stateLE. -/
theorem regional_orbit_coupling_lift (m : Nat) (hm : RegionalSize m)
    (refmode tarmode : Fin 3) (q p : Parameter)
    (π : RegionalOrbit m hm → RegionalOrbit m hm → ℝ)
    (nonneg : ∀ a b, 0 ≤ π a b)
    (rows : ∀ a, ∑ b, π a b = orbitMass
      (finiteStateLaw q (regionalState m hm refmode)).mass (regionalOrbitProjection m hm) a)
    (cols : ∀ b, ∑ a, π a b = orbitMass
      (finiteStateLaw p (regionalState m hm tarmode)).mass (regionalOrbitProjection m hm) b)
    (ordered : ∀ a b, 0 < π a b → a ≤ b) :
    letI := regionalBoundaryPreorder (squareBoundary m).size
    monotoneCoupling (finiteStateLaw q (regionalState m hm refmode))
      (finiteStateLaw p (regionalState m hm tarmode)) := by
  letI := regionalBoundaryPreorder (squareBoundary m).size
  exact orbit_coupling_lift
    (finiteStateLaw q (regionalState m hm refmode))
    (finiteStateLaw p (regionalState m hm tarmode)) (regionalOrbitProjection m hm)
    (regionalOrbitProjection_fibers m hm) (regionalState_orderAction m hm)
    (regionalOrbit_le_iff m hm)
    (regionalStateLaw_invariant m hm refmode q) (regionalStateLaw_invariant m hm tarmode p)
    π nonneg rows cols ordered

/-- The dominance form uses C's finite Strassen internally, with the same actual laws. -/
theorem regional_orbit_domination_lift (m : Nat) (hm : RegionalSize m)
    (refmode tarmode : Fin 3) (q p : Parameter)
    (h : finiteDominates
      (finiteLawMap (finiteStateLaw q (regionalState m hm refmode)) (regionalOrbitProjection m hm))
      (finiteLawMap (finiteStateLaw p (regionalState m hm tarmode)) (regionalOrbitProjection m hm))) :
    letI := regionalBoundaryPreorder (squareBoundary m).size
    monotoneCoupling (finiteStateLaw q (regionalState m hm refmode))
      (finiteStateLaw p (regionalState m hm tarmode)) := by
  letI := regionalBoundaryPreorder (squareBoundary m).size
  exact orbit_domination_lift
    (finiteStateLaw q (regionalState m hm refmode))
    (finiteStateLaw p (regionalState m hm tarmode)) (regionalOrbitProjection m hm)
    (regionalOrbitProjection_fibers m hm) (regionalState_orderAction m hm)
    (regionalOrbit_le_iff m hm)
    (regionalStateLaw_invariant m hm refmode q) (regionalStateLaw_invariant m hm tarmode p) h

end SitePerc.Checker

namespace SitePerc.Checker

/-- Every generated group element is an actually inspected canonical candidate. -/
theorem regional_canonical_le_of_orbit (m : Nat) (hm : RegionalSize m)
    (xs ys : List Nat) (hx : xs.length = (squareBoundary m).size)
    (hy : ys.length = (squareBoundary m).size) (g : regionalActionGroup m hm)
    (hg : stateOfLabels (squareBoundary m).size ys =
      g • stateOfLabels (squareBoundary m).size xs) :
    canonicalKey xs (regionalPerms m) ≤ packR10 (normalize ys) := by
  obtain ⟨t, ht⟩ := regional_generated_represented m hm (g⁻¹).val (g⁻¹).property
  have hboundary : regionalBoundaryIndexEquiv m hm t = g.val.2.symm := congrArg Prod.snd ht
  have hi : t.val < (regionalPerms m).size := by
    rw [(regionalPermutationData m hm).1]
    exact t.isLt
  let p := (regionalPerms m)[t.val]!
  have hp : p ∈ (regionalPerms m).toList := by
    dsimp [p]
    rw [getElem!_pos (regionalPerms m) t.val hi]
    exact Array.getElem_mem_toList hi
  have hr : RepresentsPermutation (squareBoundary m).size p
      (regionalBoundaryIndexEquiv m hm t) := regionalBoundaryIndexEquiv_represents m hm t
  have heq : stateOfLabels (squareBoundary m).size (permute xs p) =
      stateOfLabels (squareBoundary m).size ys := by
    rw [stateOfLabels_permute _ xs p _ hr, hboundary]
    exact hg.symm
  have hn := normalize_eq_of_stateOfLabels_eq _ (permute xs p) ys
    (by simp [permute, hr.1]) hy heq
  exact (regional_canonicalKey_le xs (regionalPerms m)).2 p hp |>.trans_eq (congrArg packR10 hn)

/-- The actual finite canonical min is monotone under orbit equality in both directions. -/
theorem regional_canonical_le_canonical_of_orbit (m : Nat) (hm : RegionalSize m)
    (xs ys : List Nat) (hx : xs.length = (squareBoundary m).size)
    (hy : ys.length = (squareBoundary m).size) (g : regionalActionGroup m hm)
    (hg : stateOfLabels (squareBoundary m).size ys =
      g • stateOfLabels (squareBoundary m).size xs) :
    canonicalKey xs (regionalPerms m) ≤ canonicalKey ys (regionalPerms m) := by
  obtain ⟨zs, hz, hkey, k, hk⟩ := regional_canonical_witness m hm ys hy
  rw [hkey]
  apply regional_canonical_le_of_orbit m hm xs zs hx hz (k * g)
  rw [mul_smul, ← hg]
  exact hk

/-- The actual canonical key is constant on genuine generated-group orbits. -/
theorem regional_canonical_invariant (m : Nat) (hm : RegionalSize m)
    (xs ys : List Nat) (hx : xs.length = (squareBoundary m).size)
    (hy : ys.length = (squareBoundary m).size) (g : regionalActionGroup m hm)
    (hg : stateOfLabels (squareBoundary m).size ys =
      g • stateOfLabels (squareBoundary m).size xs) :
    canonicalKey xs (regionalPerms m) = canonicalKey ys (regionalPerms m) := by
  apply le_antisymm (regional_canonical_le_canonical_of_orbit m hm xs ys hx hy g hg)
  apply regional_canonical_le_canonical_of_orbit m hm ys xs hy hx g⁻¹
  rw [hg, inv_smul_smul]

/-- Canonical decoding projects to exactly the original state orbit. -/
theorem regional_canonical_decode_projection (m : Nat) (hm : RegionalSize m)
    (xs : List Nat) (hx : xs.length = (squareBoundary m).size) :
    regionalOrbitProjection m hm (decodeState (squareBoundary m).size
      (canonicalKey xs (regionalPerms m))) =
      regionalOrbitProjection m hm (stateOfLabels (squareBoundary m).size xs) := by
  obtain ⟨g, hg⟩ := regional_canonical_decode_orbit m hm xs hx
  exact ((regionalOrbitProjection_fibers m hm _ _).mpr ⟨g, hg.symm⟩).symm

/-- The actual canonical-key fibers are precisely the actual boundary-state orbits. -/
theorem regional_canonical_fibers (m : Nat) (hm : RegionalSize m)
    (xs ys : List Nat) (hx : xs.length = (squareBoundary m).size)
    (hy : ys.length = (squareBoundary m).size) :
    canonicalKey xs (regionalPerms m) = canonicalKey ys (regionalPerms m) ↔
      regionalOrbitProjection m hm (stateOfLabels (squareBoundary m).size xs) =
        regionalOrbitProjection m hm (stateOfLabels (squareBoundary m).size ys) := by
  constructor
  · intro hkey
    rw [← regional_canonical_decode_projection m hm xs hx,
      ← regional_canonical_decode_projection m hm ys hy, hkey]
  · intro horbit
    obtain ⟨g, hg⟩ := (regionalOrbitProjection_fibers m hm _ _).mp horbit
    exact regional_canonical_invariant m hm xs ys hx hy g hg.symm

/-- C1-valid actual canonical keys cannot alias even after orbit projection. -/
theorem regional_valid_key_orbit_injective (m : Nat) (hm : RegionalSize m)
    (src dst : Nat) (hs : validCanonical (squareBoundary m).size (regionalPerms m) src = true)
    (ht : validCanonical (squareBoundary m).size (regionalPerms m) dst = true)
    (hOrbit : regionalOrbitProjection m hm (decodeState (squareBoundary m).size src) =
      regionalOrbitProjection m hm (decodeState (squareBoundary m).size dst)) : src = dst := by
  have hk := (regional_canonical_fibers m hm
    (r10Labels (squareBoundary m).size src) (r10Labels (squareBoundary m).size dst)
    (by simp only [r10Labels, List.length_reverse, length_unpack])
    (by simp only [r10Labels, List.length_reverse, length_unpack])).mpr hOrbit
  rw [(validCanonical_semantics _ _ src hs).2.2.2.1,
    (validCanonical_semantics _ _ dst ht).2.2.2.1] at hk
  exact hk

end SitePerc.Checker

namespace SitePerc.Checker

/-- Reindex both augmented-state fields along the actual ordered-boundary equivalence. -/
noncomputable def regionalBoundaryTransport (m : Nat) (hm : RegionalSize m) :
    BoundaryState (Fin (squareBoundary m).size) ≃ BoundaryState (Boundary m) where
  toFun s :=
    { opened := fun b => s.opened ((regionalBoundaryEquiv m hm).symm b)
      connected := fun b c => s.connected ((regionalBoundaryEquiv m hm).symm b)
        ((regionalBoundaryEquiv m hm).symm c) }
  invFun s :=
    { opened := fun b => s.opened (regionalBoundaryEquiv m hm b)
      connected := fun b c => s.connected (regionalBoundaryEquiv m hm b)
        (regionalBoundaryEquiv m hm c) }
  left_inv s := by cases s; simp
  right_inv s := by cases s; simp

/-- Transport preserves and reflects exactly Base's stateLE. -/
theorem regionalBoundaryTransport_order (m : Nat) (hm : RegionalSize m)
    (s t : BoundaryState (Fin (squareBoundary m).size)) :
    stateLE (regionalBoundaryTransport m hm s) (regionalBoundaryTransport m hm t) ↔
      stateLE s t := by
  constructor
  · intro h
    constructor
    · intro i hi
      simpa [regionalBoundaryTransport] using h.1 (regionalBoundaryEquiv m hm i)
        (by simpa [regionalBoundaryTransport] using hi)
    · intro i j hi hj hc
      simpa [regionalBoundaryTransport] using h.2 (regionalBoundaryEquiv m hm i)
        (regionalBoundaryEquiv m hm j) (by simpa [regionalBoundaryTransport] using hi)
        (by simpa [regionalBoundaryTransport] using hj)
        (by simpa [regionalBoundaryTransport] using hc)
  · intro h
    exact ⟨fun b hb => h.1 _ hb, fun b c hb hc hbc => h.2 _ _ hb hc hbc⟩

/-- A graph identity yields the exact localState extraction identity, internally. -/
theorem regionalState_eq_localState (m : Nat) (hm : RegionalSize m) (mode : Fin 3)
    (G : SimpleGraph Vertex) (shift i : Vertex)
    (hgraph : ∀ a b : Fin (m*m),
      (tileGraph G m shift i).Adj (rowMajor m a) (rowMajor m b) ↔
        (edgeGraph (m*m) (gridEdges m mode.val)).Adj a b)
    (ω : Configuration (Cell m)) :
    regionalBoundaryTransport m hm
      (regionalState m hm mode (fun v => ω (rowMajor m v))) = localState G m shift i ω := by
  classical
  let φ : siteGraph (edgeGraph (m*m) (gridEdges m mode.val))
      (fun v => ω (rowMajor m v)) ≃g siteGraph (tileGraph G m shift i) ω :=
    { toEquiv := rowMajor m
      map_rel_iff' := by
        intro a b
        simp only [siteGraph, SimpleGraph.fromRel_adj, (rowMajor m).injective.ne_iff, hgraph] }
  have hb (b : Boundary m) :
      rowMajor m (regionalBoundaryVertex m hm ((regionalBoundaryEquiv m hm).symm b)) = b.val := by
    change (regionalBoundaryEquiv m hm ((regionalBoundaryEquiv m hm).symm b)).val = b.val
    rw [Equiv.apply_symm_apply]
  change BoundaryState.mk _ _ = BoundaryState.mk _ _
  congr 1
  · funext b
    exact congrArg ω (hb b)
  · funext b c
    change decide ((siteGraph (edgeGraph (m*m) (gridEdges m mode.val))
      (fun v => ω (rowMajor m v))).Reachable
        (regionalBoundaryVertex m hm ((regionalBoundaryEquiv m hm).symm b))
        (regionalBoundaryVertex m hm ((regionalBoundaryEquiv m hm).symm c))) =
      decide ((siteGraph (tileGraph G m shift i) ω).Reachable b.val c.val)
    simp only [decide_eq_decide]
    have h := (SimpleGraph.Iso.reachable_iff (φ := φ)
      (u := regionalBoundaryVertex m hm ((regionalBoundaryEquiv m hm).symm b))
      (v := regionalBoundaryVertex m hm ((regionalBoundaryEquiv m hm).symm c))).symm
    change ((siteGraph (edgeGraph (m*m) (gridEdges m mode.val))
      (fun v => ω (rowMajor m v))).Reachable
        (regionalBoundaryVertex m hm ((regionalBoundaryEquiv m hm).symm b))
        (regionalBoundaryVertex m hm ((regionalBoundaryEquiv m hm).symm c)) ↔
      (siteGraph (tileGraph G m shift i) ω).Reachable
        (rowMajor m (regionalBoundaryVertex m hm ((regionalBoundaryEquiv m hm).symm b)))
        (rowMajor m (regionalBoundaryVertex m hm ((regionalBoundaryEquiv m hm).symm c)))) at h
    simpa only [hb] using h

/-- The four actual six-by-six stage extractions, valid in every tile. -/
theorem regionalState6_localState (i : Vertex) (ω : Configuration (Cell 6)) :
    regionalBoundaryTransport 6 (by decide)
        (regionalState 6 (by decide) 1 (fun v => ω (rowMajor 6 v))) =
      localState lineLattice 6 (0,0) i ω ∧
    regionalBoundaryTransport 6 (by decide)
        (regionalState 6 (by decide) 0 (fun v => ω (rowMajor 6 v))) =
      localState intermediate 6 (0,0) i ω ∧
    regionalBoundaryTransport 6 (by decide)
        (regionalState 6 (by decide) 2 (fun v => ω (rowMajor 6 v))) =
      localState intermediate 6 (3,3) i ω ∧
    regionalBoundaryTransport 6 (by decide)
        (regionalState 6 (by decide) 0 (fun v => ω (rowMajor 6 v))) =
      localState square 6 (3,3) i ω := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · apply regionalState_eq_localState
    intro a b
    rw [tileGraph_lineLattice_periodic]
    exact (regional_graph6_bridge a b).1
  · apply regionalState_eq_localState
    intro a b
    rw [tileGraph_intermediate_periodic]
    exact (regional_graph6_bridge a b).2.1
  · apply regionalState_eq_localState
    intro a b
    rw [tileGraph_intermediate_periodic]
    exact (regional_graph6_bridge a b).2.2.1
  · apply regionalState_eq_localState
    intro a b
    rw [tileGraph_square_periodic]
    exact (regional_graph6_bridge a b).2.2.2

end SitePerc.Checker

namespace SitePerc.Checker

/-- The actual iid law is preserved by the literal row-major coordinate equivalence. -/
theorem regional_iid_rowMajor_event (m : Nat) (p : Parameter)
    (V : Set (Configuration (Fin (m*m)))) :
    siteMeasure p V = siteMeasure (A := Cell m) p
      {ω | (fun v => ω (rowMajor m v)) ∈ V} := by
  rw [← siteMeasure_map_injective p (rowMajor m) (rowMajor m).injective,
    Measure.map_apply (by fun_prop) (Set.toFinite V).measurableSet]
  rfl

/-- Actual finite state-law domination implies Base stage-one boundary domination. -/
theorem regional_boundaryDom_stage1 (q p : Parameter)
    (h : letI := regionalBoundaryPreorder (squareBoundary 6).size
      finiteDominates
        (finiteStateLaw q (regionalState 6 (by decide) 1))
        (finiteStateLaw p (regionalState 6 (by decide) 0))) :
    boundaryDominates 6 (0,0) lineLattice intermediate q p := by
  letI := regionalBoundaryPreorder (squareBoundary 6).size
  intro i U hU
  let V := regionalBoundaryTransport 6 (by decide) ⁻¹' U
  have hV : ∀ s t, s ∈ V → s ≤ t → t ∈ V := by
    intro s t hs hst
    exact hU _ _ hs ((regionalBoundaryTransport_order 6 (by decide) s t).mpr hst)
  have hd := finiteStateLaw_domination q p (regionalState 6 (by decide) 1)
    (regionalState 6 (by decide) 0) h V hV
  rw [regional_iid_rowMajor_event, regional_iid_rowMajor_event] at hd
  convert hd using 1
  · congr 1
    ext ω
    change localState lineLattice 6 (0,0) i ω ∈ U ↔
      regionalBoundaryTransport 6 (by decide)
        (regionalState 6 (by decide) 1 (fun v => ω (rowMajor 6 v))) ∈ U
    rw [(regionalState6_localState i ω).1]
  · congr 1
    ext ω
    change localState intermediate 6 (0,0) i ω ∈ U ↔
      regionalBoundaryTransport 6 (by decide)
        (regionalState 6 (by decide) 0 (fun v => ω (rowMajor 6 v))) ∈ U
    rw [(regionalState6_localState i ω).2.1]

/-- Actual finite state-law domination implies Base shifted stage-two boundary domination. -/
theorem regional_boundaryDom_stage2 (q p : Parameter)
    (h : letI := regionalBoundaryPreorder (squareBoundary 6).size
      finiteDominates
        (finiteStateLaw q (regionalState 6 (by decide) 2))
        (finiteStateLaw p (regionalState 6 (by decide) 0))) :
    boundaryDominates 6 (3,3) intermediate square q p := by
  letI := regionalBoundaryPreorder (squareBoundary 6).size
  intro i U hU
  let V := regionalBoundaryTransport 6 (by decide) ⁻¹' U
  have hV : ∀ s t, s ∈ V → s ≤ t → t ∈ V := by
    intro s t hs hst
    exact hU _ _ hs ((regionalBoundaryTransport_order 6 (by decide) s t).mpr hst)
  have hd := finiteStateLaw_domination q p (regionalState 6 (by decide) 2)
    (regionalState 6 (by decide) 0) h V hV
  rw [regional_iid_rowMajor_event, regional_iid_rowMajor_event] at hd
  convert hd using 1
  · congr 1
    ext ω
    change localState intermediate 6 (3,3) i ω ∈ U ↔
      regionalBoundaryTransport 6 (by decide)
        (regionalState 6 (by decide) 2 (fun v => ω (rowMajor 6 v))) ∈ U
    rw [(regionalState6_localState i ω).2.2.1]
  · congr 1
    ext ω
    change localState square 6 (3,3) i ω ∈ U ↔
      regionalBoundaryTransport 6 (by decide)
        (regionalState 6 (by decide) 0 (fun v => ω (rowMajor 6 v))) ∈ U
    rw [(regionalState6_localState i ω).2.2.2]

end SitePerc.Checker
