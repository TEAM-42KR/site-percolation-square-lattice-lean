import SitePerc.Checker.DirectDefs
import SitePercDirectRegressionData
import Lean.Elab.Tactic.Decide

/-!
# Small direct-path executable regressions

Every predicate below calls the actual `directRegionalPass`, with one worker,
pure flow ByteArrays, and no producer law bytes. The external pure data module
is generated by `scripts/generate_direct_regression.py`.

These are native executable receipts, not semantic boundary-domination proofs.
Their exact native-decision axiom boundary is printed below. The OWN-ONLY H1/H2
fixtures instantiate the earlier error patterns at two-by-two size only.
-/

namespace SitePerc.Checker.DirectRegression

open SitePercDirectRegressionData

def m2StageOne : StageParams := ⟨1,1,2,0,586668,1000000,2^100⟩
def m2StageTwo : StageParams := ⟨2,586668,1000000,0,679493,1000000,2^100⟩
def m4StageOne : StageParams := ⟨1,1,2,0,5823347,10000000,2^100⟩
def m4StageTwo : StageParams := ⟨2,5823347,10000000,0,65185,100000,2^100⟩
def wiermanStageOne : StageParams := ⟨1,5000000001,10000000000,0,11733349,20000000,2^100⟩
/-- The endpoint is exactly 169873/250000 = 0.679492. -/
def wiermanStageTwo : StageParams := ⟨2,11733349,20000000,0,169873,250000,2^100⟩

def m2Check : Bool :=
  directRegionalPass 2 1 m2StageOne m2StageTwo
    m2Stage1Nodes m2Stage1Edges m2Stage2Nodes m2Stage2Edges

def m4Check : Bool :=
  directRegionalPass 4 1 m4StageOne m4StageTwo
    m4Stage1Nodes m4Stage1Edges m4Stage2Nodes m4Stage2Edges

def wierman1995Check : Bool :=
  directRegionalPass 2 1 wiermanStageOne wiermanStageTwo
    wierman1995Stage1Nodes wierman1995Stage1Edges
    wierman1995Stage2Nodes wierman1995Stage2Edges

/-- OWN-ONLY H1: empty supplied support cannot replace the internally generated laws. -/
def h1OmittedNonbottom : Bool :=
  directRegionalPass 2 1 m2StageOne m2StageTwo
    dummyStage1Nodes emptyEdges dummyStage2Nodes emptyEdges

/-- OWN-ONLY H1: a zero-node flow is not a certificate. -/
def h1ZeroNodes : Bool :=
  directRegionalPass 2 1 m2StageOne m2StageTwo
    zeroNodes emptyEdges m2Stage2Nodes m2Stage2Edges

/-- OWN-ONLY H2: the leading node is outside the actual canonical orbit keys. -/
def h2Noncanonical : Bool :=
  directRegionalPass 2 1 m2StageOne m2StageTwo
    noncanonicalNodes m2Stage1Edges m2Stage2Nodes m2Stage2Edges

/-- OWN-ONLY H2: ignored high key bits are rejected rather than aliased. -/
def h2HighBit : Bool :=
  directRegionalPass 2 1 m2StageOne m2StageTwo
    highBitNodes m2Stage1Edges m2Stage2Nodes m2Stage2Edges

/-- OWN-ONLY H2: duplicate canonical keys are rejected. -/
def h2Duplicate : Bool :=
  directRegionalPass 2 1 m2StageOne m2StageTwo
    duplicateNodes m2Stage1Edges m2Stage2Nodes m2Stage2Edges

/-- All positive and negative expectations, on exactly one executable path. -/
def allExpected : Bool :=
  m2Check && m4Check && wierman1995Check && !h1OmittedNonbottom && !h1ZeroNodes &&
    !h2Noncanonical && !h2HighBit && !h2Duplicate

-- Native receipts start here. No receipt is an extra semantic premise.
theorem m2_check_true : m2Check = true := by native_decide
theorem m4_check_true : m4Check = true := by native_decide
theorem wierman1995_check_true : wierman1995Check = true := by native_decide
theorem h1_omitted_nonbottom_false : h1OmittedNonbottom = false := by native_decide
theorem h1_zero_nodes_false : h1ZeroNodes = false := by native_decide
theorem h2_noncanonical_false : h2Noncanonical = false := by native_decide
theorem h2_high_bit_false : h2HighBit = false := by native_decide
theorem h2_duplicate_false : h2Duplicate = false := by native_decide

theorem all_expected_true : allExpected = true := by
  simp only [allExpected,m2_check_true,m4_check_true,wierman1995_check_true,
    h1_omitted_nonbottom_false,h1_zero_nodes_false,h2_noncanonical_false,
    h2_high_bit_false,h2_duplicate_false]
  rfl

set_option pp.fullNames true in
#print axioms m2_check_true
set_option pp.fullNames true in
#print axioms m4_check_true
set_option pp.fullNames true in
#print axioms wierman1995_check_true
set_option pp.fullNames true in
#print axioms h1_omitted_nonbottom_false
set_option pp.fullNames true in
#print axioms h1_zero_nodes_false
set_option pp.fullNames true in
#print axioms h2_noncanonical_false
set_option pp.fullNames true in
#print axioms h2_high_bit_false
set_option pp.fullNames true in
#print axioms h2_duplicate_false
set_option pp.fullNames true in
#print axioms all_expected_true

#eval s!"DIRECT_RESULT m2 {m2Check}"
#eval s!"DIRECT_RESULT m4 {m4Check}"
#eval s!"DIRECT_RESULT wierman1995 {wierman1995Check}"
#eval s!"DIRECT_RESULT H1_omitted_nonbottom {h1OmittedNonbottom}"
#eval s!"DIRECT_RESULT H1_zero_nodes {h1ZeroNodes}"
#eval s!"DIRECT_RESULT H2_noncanonical_orbit {h2Noncanonical}"
#eval s!"DIRECT_RESULT H2_ignored_high_bit {h2HighBit}"
#eval s!"DIRECT_RESULT H2_duplicate_key {h2Duplicate}"

end SitePerc.Checker.DirectRegression
